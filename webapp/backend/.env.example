# Path to a COPY/snapshot of the bot DB (opened read-only). No default.
# In production this is rejected if it resolves inside the repo's db/
# directory (the live bot DB) -- point it at the snapshot job's
# destination instead (see webapp/deploy/.env.example).
STOCKSAGE_DB_PATH=
# Optional override for the webapp's own state DB (default: webapp/data/webapp_state.db)
# WEBAPP_STATE_DB_PATH=

# Set to true on the server to serve the built frontend, disable
# /docs /redoc /openapi.json, and drop the dev-only /api/patterns route.
# Off (dev mode) by default.
# WEBAPP_PRODUCTION=true

# Where the built frontend (npm run build's dist/) lives in production.
# Default (if unset): C:\stocksage-deploy\dist -- outside the repo, see
# webapp/deploy/RUNBOOK.md.
# WEBAPP_FRONTEND_DIST_PATH=

# Port uvicorn binds to (default: 8000). Must be an integer 1024-65535.
# The host stays hard-coded to 127.0.0.1 -- never configurable.
# WEBAPP_PORT=8000
