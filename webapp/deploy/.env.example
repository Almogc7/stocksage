# Config for webapp/deploy/snapshot_bot_db.py. Separate from
# webapp/backend/.env on purpose -- the snapshot job is a free-standing
# deploy artifact with no import dependency on app.settings.
#
# Already covered by the root .gitignore's "webapp/**/.env*" rule
# (except .env.example) -- a real webapp/deploy/.env is never committed.

# Path to the LIVE bot DB (opened read-only). No default -- fails
# loudly if unset.
SNAPSHOT_SOURCE_DB_PATH=

# Where the verified snapshot copy is atomically written. Default (if
# unset): C:\stocksage-deploy\snapshot\bot.db
# SNAPSHOT_DEST_DB_PATH=

# Where this job appends its own timestamped log lines. Default (if
# unset): C:\stocksage-deploy\logs\snapshot.log
# SNAPSHOT_LOG_PATH=
